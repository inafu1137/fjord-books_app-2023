<h1>ユーザー詳細</h1>

<p><strong>メール:</strong> <%= @user.email %></p>
<p><strong>郵便番号:</strong> <%= @user.postal_code %></p>
<p><strong>住所:</strong> <%= @user.address %></p>
<p><strong>自己紹介:</strong> <%= simple_format(@user.introduction) %></p>

<% if current_user == @user %>
  <%= link_to 'アカウントを編集する', edit_user_registration_path, class: 'btn btn-primary' %>
<% end %>

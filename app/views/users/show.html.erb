<h1><%= t('views.common.title_show', name: 'ユーザー') %></h1>

<p><strong><%= User.human_attribute_name(:email) %>:</strong> <%= @user.email %></p>
<p><strong><%= User.human_attribute_name(:postal_code) %>:</strong> <%= @user.postal_code %></p>
<p><strong><%= User.human_attribute_name(:address) %>:</strong> <%= @user.address %></p>
<p><strong><%= User.human_attribute_name(:introduction) %>:</strong> <%= simple_format(@user.introduction) %></p>

<% if current_user == @user %>
  <%= link_to t('views.common.edit', name: 'アカウント'), edit_user_registration_path, class: 'btn btn-primary' %>
<% end %>

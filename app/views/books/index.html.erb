<p style="color: green"><%= notice %></p>

<h1><%= t('views.books.index.title') %></h1>

<div id="books" class="index-items">
  <% @books.each do |book| %>
    <div class="index-item">
      <%= render book %>
      <p>
        <%= link_to t("views.books.index.show", name: Book.model_name.human), book %>
      </p>
    </div>
  <% end %>
</div>

<nav class="page-nav">
  <%= link_to t("views.common.new", name: Book.model_name.human), new_book_path %>
</nav>

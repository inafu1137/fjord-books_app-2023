<h1>コメントの編集</h1>

<%= form_with(model: @comment, local: true) do |form| %>
<% if @comment.errors.any? %>
<div class="error_messages">
    <ul>
        <% @comment.errors.full_messages.each do |message| %>
        <li><%= message %></li>
        <% end %>
    </ul>
</div>
<% end %>

<div class="field">
    <%= form.text_area :body, required: true %>
</div>

<div class="actions">
    <%= form.submit '更新する' %>
</div>
<% end %>

<%= link_to '戻る', @comment.commentable %>